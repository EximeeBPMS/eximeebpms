<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure>
  <deployment>
    <exclusions>
      <module name="com.fasterxml.jackson.datatype.jackson-datatype-jsr310" />
      <module name="org.jboss.resteasy.resteasy-jackson2-provider" />
      <!-- resteasy-jackson-provider (Jackson 1.x) and resteasy-jettison-provider were
           removed from modern RESTEasy/WildFly - excluding them logs a harmless but
           noisy WFLYSRV0274 warning since there is nothing to exclude -->
    </exclusions>
  </deployment>
</jboss-deployment-structure>
