<module xmlns="urn:jboss:module:1.0" name="org.eximeebpms.bpm.eximeebpms-engine-plugin-events-kafka">
  <resources>
    <resource-root path="eximeebpms-engine-plugin-events-kafka-@project.version@.jar" />
  </resources>

  <dependencies>

    <module name="java.base" />

    <!-- BusinessEventPublisher, Event, EventHeaders -->
    <module name="org.eximeebpms.commons.eximeebpms-commons-event-bus-api" />

    <!-- Kafka client API/runtime -->
    <module name="org.apache.kafka.kafka-clients" />

    <!-- Kafka compression/runtime dependencies -->
    <module name="org.lz4.lz4-java" optional="true" />
    <module name="org.xerial.snappy.snappy-java" optional="true" />
    <module name="com.github.luben.zstd-jni" optional="true" />

    <!-- JSON serializer -->
    <module name="com.fasterxml.jackson.core.jackson-annotations" />
    <module name="com.fasterxml.jackson.core.jackson-core" />
    <module name="com.fasterxml.jackson.core.jackson-databind" />
    <module name="com.fasterxml.jackson.datatype.jackson-datatype-jsr310" />

    <!-- Logging API used by the publisher -->
    <module name="org.slf4j" />

  </dependencies>
</module>
