<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="businessKeyUpdate" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="userTask" />
    <userTask id="userTask">
      <extensionElements>
        <camunda:executionListener event="start" expression="${execution.setProcessBusinessKey('updatedKey')}"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow2" sourceRef="userTask" targetRef="end" />
    <endEvent id="end" />
  </process>

</definitions>
