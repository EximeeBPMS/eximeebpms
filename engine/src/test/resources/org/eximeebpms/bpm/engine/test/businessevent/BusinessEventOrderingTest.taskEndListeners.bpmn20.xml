<?xml version="1.0" encoding="UTF-8"?>
<definitions id="definitions"
  xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  targetNamespace="Examples">

  <process id="taskEndListeners" isExecutable="true">
    <startEvent id="start" />
    <sequenceFlow id="flow1" sourceRef="start" targetRef="userTask" />
    <userTask id="userTask">
      <extensionElements>
        <camunda:taskListener event="complete" expression="${task.execution.setVariable('fromCompleteListener', 'value')}" />
        <camunda:taskListener event="delete" expression="${task.execution.setVariable('fromDeleteListener', 'value')}" />
      </extensionElements>
    </userTask>
    <sequenceFlow id="flow2" sourceRef="userTask" targetRef="waitState" />
    <receiveTask id="waitState" />
    <sequenceFlow id="flow3" sourceRef="waitState" targetRef="end" />
    <endEvent id="end" />
  </process>

</definitions>
