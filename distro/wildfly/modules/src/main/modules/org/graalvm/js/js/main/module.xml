<!-- org.graalvm.js:js is a pom-only aggregator artifact (no jar is published for it in
     GraalVM 25.x), so this module carries no resources of its own. It only re-exports the
     real language runtime jars (js-language, truffle-runtime) it aggregates. -->
<module xmlns="urn:jboss:module:1.0" name="org.graalvm.js.js">
  <dependencies>
    <module name="java.base" />
    <module name="org.eximeebpms.spin.eximeebpms-spin-core" />
    <module name="org.graalvm.js.js-language" services="export" export="true" />
    <module name="org.graalvm.truffle.truffle-runtime" services="export" export="true" />
  </dependencies>
</module>
