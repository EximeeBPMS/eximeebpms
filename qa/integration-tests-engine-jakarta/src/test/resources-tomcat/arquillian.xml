<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian-1.0.xsd">

  <defaultProtocol type="Servlet 5.0" />

  <engine>
        <property name="deploymentExportPath">target/deployments</property>
  </engine>

  <container qualifier="tomcat" default="true">
    <configuration>
      <property name="catalinaHome">${tomcat.runtime.location}</property>
      <property name="catalinaBase">${tomcat.runtime.location}</property>
      <property name="bindHttpPort">${tomcat.connector.http.port}</property>
      <property name="user">arquillian</property>
      <property name="pass">arquillian</property>
      <property name="jmxPort">8089</property>
      <!-- The ${eximeebpms.ds.*} placeholders are unknown to Maven, so filtering leaves
           them for Arquillian, which resolves them from this JVM's system properties
           after DatabaseContainerPlaceholderResolver has had its turn. -->
      <property name="javaVmArguments">-Xmx512m -Deximeebpms.ds.url=${eximeebpms.ds.url} -Deximeebpms.ds.driver=${eximeebpms.ds.driver} -Deximeebpms.ds.username=${eximeebpms.ds.username} -Deximeebpms.ds.password=${eximeebpms.ds.password}</property>
<!--       <property name="javaVmArguments">-Xmx512m -Xrunjdwp:transport=dt_socket,address=8787,server=y,suspend=y</property> -->
    </configuration>
  </container>
</arquillian>
