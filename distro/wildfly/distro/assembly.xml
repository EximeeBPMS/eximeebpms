<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="urn:maven:assembly:1.1.2">

  <id>distro</id>

  <formats>
    <format>zip</format>
    <format>tar.gz</format>
  </formats>

  <includeBaseDirectory>false</includeBaseDirectory>

  <dependencySets>

    <dependencySet>
      <unpack>true</unpack>
      <includes>
        <include>org.eximeebpms.bpm.wildfly:eximeebpms-wildfly-assembly</include>
      </includes>
      <outputDirectory />
    </dependencySet>

    <dependencySet>
      <outputDirectory />
      <unpack>true</unpack>
      <unpackOptions>
        <excludes>
          <exclude>**/META-INF/**</exclude>
        </excludes>
      </unpackOptions>
      <includes>
        <include>org.eximeebpms.bpm.distro:eximeebpms-sql-scripts:jar:*</include>
      </includes>
    </dependencySet>

    <dependencySet>
        <outputFileNameMapping>${artifact.artifactId}-${artifact.version}.${artifact.extension}</outputFileNameMapping>
        <includes>
            <include>org.eximeebpms.bpm:eximeebpms-engine-rest-jakarta:war:*</include>
        </includes>
        <outputDirectory>server/wildfly-${version.wildfly}/standalone/deployments</outputDirectory>
    </dependencySet>

    <dependencySet>
        <includes>
          <include>org.eximeebpms.bpm.webapp:eximeebpms-webapp-wildfly:war:*</include>
        </includes>
        <outputDirectory>server/wildfly-${version.wildfly}/standalone/deployments</outputDirectory>
    </dependencySet>

    <dependencySet>
        <includes>
          <include>org.eximeebpms.bpm.example:eximeebpms-example-invoice-jakarta:war:*</include>
        </includes>
        <outputDirectory>server/wildfly-${version.wildfly}/standalone/deployments</outputDirectory>
    </dependencySet>

    <dependencySet>
      <outputDirectory>server/wildfly-${version.wildfly}/modules/org/eximeebpms/bpm/engine/plugins/events/kafka/main</outputDirectory>
      <useProjectArtifact>false</useProjectArtifact>
      <useTransitiveDependencies>false</useTransitiveDependencies>
      <includes>
        <include>org.eximeebpms.bpm:eximeebpms-engine-plugin-events-kafka:jar</include>
        <include>org.apache.kafka:kafka-clients:jar</include>
        <include>org.lz4:lz4-java:jar</include>
        <include>org.xerial.snappy:snappy-java:jar</include>
        <include>com.github.luben:zstd-jni:jar</include>
        <include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310:jar:*</include>
        <include>com.fasterxml.jackson.core:jackson-databind:jar</include>
        <include>com.fasterxml.jackson.core:jackson-core:jar</include>
        <include>com.fasterxml.jackson.core:jackson-annotations:jar</include>
        <include>com.fasterxml.jackson.datatype:jackson-datatype-jsr310:jar</include>
      </includes>
    </dependencySet>

  </dependencySets>

  <fileSets>
    <fileSet>
      <directory>../../eximeebpms-welcome</directory>
      <outputDirectory>server/wildfly-${version.wildfly}/standalone/deployments/eximeebpms-welcome.war</outputDirectory>
    </fileSet>
  </fileSets>

  <files>
     <file>
      <source>src/EMPTY_FILE</source>
      <outputDirectory>server/wildfly-${version.wildfly}/standalone/deployments/</outputDirectory>
      <destName>eximeebpms-welcome.war.dodeploy</destName>
    </file>
  </files>

</assembly>
