<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>eximeebpms-bpm-archunit</artifactId>
    <packaging>jar</packaging>

    <name>EximeeBPMS - ArchUnit</name>

    <parent>
        <groupId>org.eximeebpms.bpm</groupId>
        <artifactId>eximeebpms-database-settings</artifactId>
        <relativePath>../../database</relativePath>
        <version>1.5.0-SNAPSHOT</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${version.archunit-junit5}</version>
        </dependency>
        <!-- archunit-junit5 puts JUnit Platform on every consuming module's test
             classpath, without junit-vintage-engine. Surefire's provider
             auto-detection then selects JUnitPlatformProvider, which can discover
             this module's own JUnit5-native ArchRulesTest but has no engine that
             can run any JUnit4 @Test class - not reported as skipped, silently
             invisible to it. Confirmed: every module depending on
             eximeebpms-bpm-archunit (engine, engine-dmn/engine, engine-spring/core-6,
             model-api/bpmn-model, model-api/dmn-model, commons/typed-values) was
             running 0 of its own JUnit4 tests via a plain `mvn test`/`install`
             (CI's actual invocation), only ArchRulesTest. -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${version.junit-jupiter}</version>
        </dependency>
    </dependencies>

</project>
