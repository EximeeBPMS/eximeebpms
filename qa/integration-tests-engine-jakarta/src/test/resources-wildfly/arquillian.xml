<?xml version="1.0" encoding="UTF-8"?>
<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian-1.0.xsd">

  <defaultProtocol type="Servlet 5.0" />

  <engine>
        <property name="deploymentExportPath">target/deployments</property>
  </engine>

  <container qualifier="jboss" default="true">
    <configuration>
      <property name="jbossHome">${wildfly.runtime.location}</property>
      <property name="managementPort">${jboss.management-http.port}</property>
      <property name="serverConfig">standalone.xml</property>
      <!-- The ${eximeebpms.ds.*} placeholders are unknown to Maven, so filtering leaves
           them for Arquillian, which resolves them from this JVM's system properties
           after DatabaseContainerPlaceholderResolver has had its turn. -->
      <property name="javaVmArguments">-Xmx1024m -Deximeebpms.ds.url=${eximeebpms.ds.url} -Deximeebpms.ds.username=${eximeebpms.ds.username} -Deximeebpms.ds.password=${eximeebpms.ds.password} -Deximeebpms.ds.host=${eximeebpms.ds.host} -Deximeebpms.ds.port=${eximeebpms.ds.port} -Deximeebpms.ds.name=${eximeebpms.ds.name}</property>
      <property name="startupTimeoutInSeconds">300</property>
<!--       <property name="javaVmArguments">-Xmx1024m -Xrunjdwp:transport=dt_socket,address=8787,server=y,suspend=y</property> -->
    </configuration>
  </container>
</arquillian>
