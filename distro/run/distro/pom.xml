<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eximeebpms.bpm.run</groupId>
    <artifactId>eximeebpms-bpm-run-root</artifactId>
    <version>1.4.0</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>eximeebpms-bpm-run</artifactId>
  <name>EximeeBPMS - Run - Distribution</name>
  <packaging>pom</packaging>

  <dependencies>

    <dependency>
      <groupId>org.eximeebpms.bpm.run</groupId>
      <artifactId>eximeebpms-bpm-run-assembly</artifactId>
      <version>${project.version}</version>
      <type>tar.gz</type>
    </dependency>

    <dependency>
      <groupId>org.eximeebpms.bpm.distro</groupId>
      <artifactId>eximeebpms-sql-scripts</artifactId>
      <version>${project.version}</version>
      <type>jar</type>
    </dependency>

    <!-- make sure this runs after webapps -->
    <dependency>
      <groupId>org.eximeebpms.bpm.run</groupId>
      <artifactId>eximeebpms-bpm-run-modules-webapps</artifactId>
      <version>${project.version}</version>
      <type>pom</type>
      <exclusions>
        <!-- we don't need any transitive dependencies -->
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <appendAssemblyId>false</appendAssemblyId>
          <outputDirectory>target/</outputDirectory>
          <tarLongFileMode>gnu</tarLongFileMode>
        </configuration>
        <executions>
          <execution>
            <id>assemble</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>assembly.xml</descriptor>
              </descriptors>
              <workDirectory>target/assembly/work</workDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <distro.deploy.skip>false</distro.deploy.skip>
  </properties>

  <profiles>
    <profile>
      <!-- Not staged for Maven Central: eximeebpms-bpm-run's two archives are ~429MB of the
        JReleaser upload bundle, which the release runner cannot multipart-encode within its pod
        memory limit (BPMS-760). The archives ship as GitHub Release assets instead, the same way
        operaton does it. They are still published to Central, but as a separate step after the
        release - see guidelines/common/release-checklist.md. Placed on this child rather than on
        distro/run/pom.xml on purpose: that aggregator carries activeByDefault profiles, and
        activating a profile explicitly defined in a POM deactivates every other activeByDefault
        profile in that SAME POM. This POM has none, so scoping it here is safe. -->
      <id>sonatype-oss-release</id>
      <properties>
        <!-- Not a constant: snapshots still go to Central's snapshot repository, where there is
          no bundle and no size problem, and where eximeebpms-docker resolves SNAPSHOT builds
          from. Only the release path sets this, in release.yml's staging step. -->
        <maven.deploy.skip>${distro.deploy.skip}</maven.deploy.skip>
      </properties>
    </profile>
  </profiles>

</project>
