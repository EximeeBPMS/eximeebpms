<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>eximeebpms-bpm-tomcat</artifactId>
  <packaging>pom</packaging>

  <parent>
    <groupId>org.eximeebpms.bpm.tomcat</groupId>
    <artifactId>eximeebpms-tomcat</artifactId>
    <version>1.5.0-SNAPSHOT</version>
  </parent>

  <name>EximeeBPMS - tomcat Distro</name>

  <dependencies>
    <dependency>
      <groupId>org.eximeebpms.bpm.distro</groupId>
      <artifactId>eximeebpms-sql-scripts</artifactId>
      <version>${project.version}</version>
      <type>jar</type>
    </dependency>

    <!-- Tomcat 10 dependencies -->

    <dependency>
      <groupId>org.eximeebpms.bpm.tomcat</groupId>
      <artifactId>eximeebpms-tomcat-assembly</artifactId>
      <version>${project.version}</version>
      <type>tar.gz</type>
    </dependency>

    <dependency>
      <groupId>org.eximeebpms.bpm.webapp</groupId>
      <artifactId>eximeebpms-webapp-tomcat-jakarta</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>

    <dependency>
      <groupId>org.eximeebpms.bpm</groupId>
      <artifactId>eximeebpms-engine-rest-jakarta</artifactId>
      <version>${project.version}</version>
      <classifier>tomcat</classifier>
      <type>war</type>
    </dependency>

    <dependency>
      <groupId>org.eximeebpms.bpm.example</groupId>
      <artifactId>eximeebpms-example-invoice-jakarta</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>distro-tomcat10</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>assembly.xml</descriptor>
              </descriptors>
              <finalName>eximeebpms-bpm-tomcat-${project.version}</finalName>
              <attach>true</attach>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>target/</outputDirectory>
              <workDirectory>target/assembly/work</workDirectory>
              <tarLongFileMode>gnu</tarLongFileMode>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <properties>
    <distro.deploy.skip>false</distro.deploy.skip>
  </properties>

  <profiles>
    <profile>
      <!-- Not staged for Maven Central: eximeebpms-bpm-tomcat's two archives are ~456MB of the
        JReleaser upload bundle, which the release runner cannot multipart-encode within its pod
        memory limit (BPMS-760). The archives ship as GitHub Release assets instead, the same way
        operaton does it. They are still published to Central, but as a separate step after the
        release - see guidelines/common/release-checklist.md. Placed on this child rather than on
        distro/tomcat/pom.xml on purpose: that aggregator carries activeByDefault profiles, and
        activating a profile explicitly defined in a POM deactivates every other activeByDefault
        profile in that SAME POM, which is what silently dropped this module out of 1.3.0. This
        POM has none, so scoping it here is safe. -->
      <id>sonatype-oss-release</id>
      <properties>
        <!-- Not a constant: snapshots still go to Central's snapshot repository, where there is
          no bundle and no size problem, and where eximeebpms-docker resolves SNAPSHOT builds
          from. Only the release path sets this, in release.yml's staging step. -->
        <maven.deploy.skip>${distro.deploy.skip}</maven.deploy.skip>
      </properties>
    </profile>
  </profiles>

</project>
